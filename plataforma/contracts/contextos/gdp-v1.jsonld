{
  "@context": {
    "gdp": "https://paas-patrimonio.example/vocab/gdp#",
    "saref": "https://saref.etsi.org/core/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "HeritageBuilding": "gdp:HeritageBuilding",
    "HeritageZone": "gdp:HeritageZone",
    "HeritageElement": "gdp:HeritageElement",
    "EnvironmentalSensor": "saref:Device",
    "IndoorEnvironmentObserved": "saref:Observation",
    "ClimateAssessment": "gdp:ClimateAssessment",
    "ConservationAlert": "gdp:ConservationAlert",

    "name": "schema:name",
    "protectionLevel": "gdp:protectionLevel",
    "architecturalStyle": "gdp:architecturalStyle",
    "yearOfConstruction": "gdp:yearOfConstruction",
    "zoneType": "gdp:zoneType",
    "dominantMaterials": "gdp:dominantMaterials",
    "areaSqm": "gdp:areaSqm",
    "climateReference": "gdp:climateReference",
    "planPosition": "gdp:planPosition",
    "elementType": "gdp:elementType",
    "material": "gdp:material",
    "conditionStatus": "gdp:conditionStatus",
    "lastInspection": { "@id": "gdp:lastInspection", "@type": "xsd:date" },
    "deviceCategory": "saref:hasCategory",
    "serialNumber": "schema:serialNumber",
    "operStatus": "gdp:operStatus",
    "temperature": "gdp:temperature",
    "relativeHumidity": "gdp:relativeHumidity",
    "dateObserved": { "@id": "gdp:dateObserved", "@type": "xsd:dateTime" },

    "targetTemperature": "gdp:targetTemperature",
    "targetHumidity": "gdp:targetHumidity",
    "deviationLast30d": "gdp:deviationLast30d",
    "riskLevel": "gdp:riskLevel",
    "method": "gdp:method",
    "dataOrigin": "gdp:dataOrigin",
    "computedAt": { "@id": "gdp:computedAt", "@type": "xsd:dateTime" },
    "severity": "gdp:severity",
    "cause": "gdp:cause",
    "detectedAt": { "@id": "gdp:detectedAt", "@type": "xsd:dateTime" },
    "alertStatus": "gdp:alertStatus",
    "closedBy": "gdp:closedBy",
    "closureCause": "gdp:closureCause",

    "refBuilding": { "@id": "gdp:refBuilding", "@type": "@id" },
    "refZone": { "@id": "gdp:refZone", "@type": "@id" },
    "refDevice": { "@id": "gdp:refDevice", "@type": "@id" },
    "refAssessment": { "@id": "gdp:refAssessment", "@type": "@id" },
    "refDeposito": { "@id": "gdp:refDeposito", "@type": "@id" }
  }
}
