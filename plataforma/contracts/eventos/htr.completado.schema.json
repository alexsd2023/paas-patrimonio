{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paas-patrimonio/contracts/eventos/htr.completado.schema.json",
  "title": "htr.completado · copia terminada",
  "description": "Lo emite el módulo HTR al registrar una Transcripcion. Escena 4 del caso, tramo 10.",
  "type": "object",
  "properties": {
    "type": { "const": "htr.completado" },
    "subject": { "pattern": "^urn:ngsi-ld:Transcripcion:" },
    "data": {
      "type": "object",
      "required": ["activo", "estado", "modelo", "lineas"],
      "properties": {
        "activo": { "type": "string", "pattern": "^urn:ngsi-ld:ActivoPatrimonial:" },
        "estado": { "const": "pendiente-validacion", "description": "La máquina nunca valida: siempre queda pendiente de la paleógrafa" },
        "modelo": { "type": "string", "pattern": "^[a-z0-9-]+@[0-9]+(\\.[0-9]+)*$", "description": "nombre@versión del modelo que transcribió" },
        "lineas": { "type": "integer", "minimum": 0 },
        "confianza": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  }
}
