# Perfil público (VPS). En el VPS: cp platform/.env.publico.example platform/.env y rellena lo marcado con «‹…›».
# Genera cada secreto con:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# ── Nombres públicos (los registros DNS A apuntan a la IP del VPS) ─────────────────────────────
DOMINIO=paas.‹tudominio›
AUTH_DOMINIO=auth.paas.‹tudominio›
# Correo para Let's Encrypt (avisos de caducidad)
ACME_EMAIL=‹tu-correo›
# IP desde la que puedes abrir la consola de administración de Keycloak (https://AUTH_DOMINIO/admin).
# Por defecto nadie; pon tu IP con /32 solo cuando la necesites y luego: docker compose ... up -d caddy
ADMIN_IP=127.0.0.1/32

# ── Direcciones que la plataforma escribe en tokens y enlaces ──────────────────────────────────
KEYCLOAK_PUBLICO=https://auth.paas.‹tudominio›
API_PUBLICO=https://paas.‹tudominio›
# El catastro no se publica: sin enlace externo en la consola
SCORPIO_PUBLICO=
# Kafka solo se usa dentro de la red de Docker
KAFKA_HOST=kafka
# MLflow comprueba el Host: debe incluir el dominio de la consola
MLFLOW_HOSTS=mlflow,mlflow:5000,localhost,localhost:*,127.0.0.1:*,172.*,paas.‹tudominio›

# ── Contraseñas y secretos (todos obligatorios, distintos y largos) ────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=‹secreto›
FUSEKI_ADMIN_PASSWORD=‹secreto›
PAAS_GESTION_SECRET=‹secreto›
# Clave con la que el catálogo cifra los secretos de las instituciones. GUÁRDALA FUERA DEL VPS.
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
CATALOGO_CLAVE=‹clave-fernet›

# ── Alta de instituciones ──────────────────────────────────────────────────────────────────────
# abierto: cualquiera se da de alta en /panel/alta · cerrado: solo el equipo del PaaS
REGISTRO=abierto

# ── Servicios externos con coste ───────────────────────────────────────────────────────────────
# En la demo pública, mejor VACÍOS: así cada institución pone su propia clave en
# Mi institución → Secretos y nadie gasta la de la plataforma.
NER_TOKEN=
AMEYALLI_URL=
SCRIPTORIUM_API_KEY=
GROQ_API_KEY=
