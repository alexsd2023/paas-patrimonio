# Copia este fichero como .env en el servidor y pon el nombre con el que el Mac llega al servidor
# (nombre de Tailscale, nombre DNS de la red local o IP)
KAFKA_HOST=nombre-del-servidor

# Puerto del puente en el servidor (por defecto 8080)
PUENTE_PORT=8088

# Puertos de los consumidores en el servidor
PROCEDENCIA_PORT=8089
GESTORIA_PORT=8090
