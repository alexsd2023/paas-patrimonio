# Copia este fichero como .env en el servidor y pon el nombre con el que el Mac llega al servidor
# (nombre de Tailscale, nombre DNS de la red local o IP)
KAFKA_HOST=nombre-del-servidor

# Puerto del puente en el servidor (por defecto 8080)
PUENTE_PORT=8088

# Puertos de los consumidores en el servidor
PROCEDENCIA_PORT=8089
GESTORIA_PORT=8090

# Puerto del catastro (Scorpio) en el servidor. Ojo: Cockpit usa el 9090 en Ubuntu
SCORPIO_PORT=9090


# La puerta (parte 8)
# Dirección con la que el Mac (y los usuarios) llegan a Keycloak: será el emisor de los tokens
KEYCLOAK_PUBLICO=http://nombre-del-servidor:8180
KEYCLOAK_PORT=8180
APISIX_PORT=9080
# Dirección pública de la puerta: con ella se escriben las URL IIIF (manifiestos, imágenes)
API_PUBLICO=http://nombre-del-servidor:9080
# El libro del notario (parte 10)
FUSEKI_PORT=3030
FUSEKI_ADMIN_PASSWORD=admin
# Trazas (parte 11)
JAEGER_PORT=16686
# Consola (/panel): Temporal, Kafka UI, Jaeger, Fuseki y MLflow se abren DENTRO de la consola (/panel/<herramienta>);
# solo Keycloak y Scorpio necesitan su dirección pública para el enlace externo
SCORPIO_PUBLICO=http://nombre-del-servidor:9090/ngsi-ld/v1/types
# Servicio externo del catálogo: NER de Lancaster (Hugging Face). Pon aquí su token; no lo subas al repositorio.
NER_TOKEN=
# Parte 12 · registro de modelos (MLflow)
MLFLOW_PORT=5000
