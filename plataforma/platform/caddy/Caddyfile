# Caddy: la única puerta del VPS. Certificados de Let's Encrypt automáticos.
# Los nombres vienen de platform/.env (DOMINIO, AUTH_DOMINIO, NEO4J_DOMINIO, ACME_EMAIL, ADMIN_IP).
{
	email {$ACME_EMAIL}
}

# Registro de accesos (JSON) para las estadísticas por país (platform/visitas.sh).
# Guarda las IP de los visitantes: se conservan 30 días como máximo.
(registro) {
	log {
		output file /var/log/caddy/accesos.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

# Consola y API → APISIX
{$DOMINIO} {
	import registro
	encode zstd gzip
	reverse_proxy apisix:9080 {
		# la cookie de sesión de la consola solo viaja por HTTPS
		header_down Set-Cookie "^(.*)$" "$1; Secure"
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# Inicio de sesión y tokens → Keycloak
{$AUTH_DOMINIO} {
	import registro
	encode zstd gzip
	# La consola de administración de Keycloak solo desde ADMIN_IP (por defecto, nadie)
	@admin_fuera {
		path /admin /admin/*
		not remote_ip {$ADMIN_IP}
	}
	respond @admin_fuera "Forbidden" 403
	reverse_proxy keycloak:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# Neo4j Browser → Neo4j. La misma dirección sirve la interfaz (HTTP, 7474) y la conexión del navegador
# a la base (Bolt sobre WebSocket, 7687). En el Browser: bolt+s://NEO4J_DOMINIO:443
{$NEO4J_DOMINIO} {
	import registro
	# Conexión del Browser a la base: WebSocket por HTTP/1.1 (Upgrade) o por HTTP/2 (CONNECT).
	# En los dos casos llega la cabecera Sec-WebSocket-Version.
	@bolt header Sec-WebSocket-Version *
	reverse_proxy @bolt neo4j:7687
	reverse_proxy neo4j:7474
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
